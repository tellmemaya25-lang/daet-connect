# Supabase project settings — copy this file to .env.local and fill in locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must be a PRIVATE Supabase Storage bucket. The app stores object paths,
# never public URLs, in tours_operators.
TOURS_OPERATOR_DOCUMENTS_BUCKET=tours-operator-documents
